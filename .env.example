# Firebase Configuration
# Replace these values with your development/staging Firebase project credentials
# to isolate this development environment from production.
VITE_FIREBASE_API_KEY=your_dev_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_dev_auth_domain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_dev_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_dev_storage_bucket.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_dev_messaging_sender_id
VITE_FIREBASE_APP_ID=your_dev_app_id
VITE_FIREBASE_VAPID_KEY=your_dev_vapid_key
